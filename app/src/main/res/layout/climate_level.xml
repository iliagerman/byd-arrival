<?xml version="1.0" encoding="utf-8"?>
<!-- One temperature range: its name and span, where it starts (not for the lowest), A/C, fan and seat heat (off, low, high). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
    android:orientation="vertical">
    <TextView android:id="@+id/level_title" style="@style/CardTitle" android:textSize="16sp" />
    <include android:id="@+id/level_from" layout="@layout/stepper" />
    <include android:id="@+id/level_temp" layout="@layout/stepper" />
    <include android:id="@+id/level_fan" layout="@layout/stepper" />
    <include android:id="@+id/level_driver" layout="@layout/stepper" />
    <include android:id="@+id/level_passenger" layout="@layout/stepper" />
</LinearLayout>
