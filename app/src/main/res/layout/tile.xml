<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="96dp" android:layout_columnWeight="1"
    android:layout_margin="6dp" android:background="@drawable/bg_tile" android:gravity="center_vertical"
    android:orientation="vertical" android:paddingHorizontal="18dp">
    <ImageView android:id="@+id/icon" android:layout_width="26dp" android:layout_height="26dp"
        android:importantForAccessibility="no" android:tint="@color/on_tile" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium" android:textColor="@color/on_tile"
        android:textSize="15sp" />
</LinearLayout>
