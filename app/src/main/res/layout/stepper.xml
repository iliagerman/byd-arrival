<?xml version="1.0" encoding="utf-8"?>
<!-- One number set with − and + buttons: label, then the value between the buttons. No typing, so it can't be invalid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="52dp" android:orientation="horizontal">
    <TextView android:id="@+id/stepper_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/on_surface" android:textSize="15sp" />
    <Button android:id="@+id/stepper_down" style="@style/ButtonText" android:layout_width="52dp" android:layout_height="48dp"
        android:layout_marginTop="0dp" android:text="−" android:textSize="22sp" />
    <TextView android:id="@+id/stepper_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="80dp" android:gravity="center" android:textColor="@color/on_surface" android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />
    <Button android:id="@+id/stepper_up" style="@style/ButtonText" android:layout_width="52dp" android:layout_height="48dp"
        android:layout_marginTop="0dp" android:text="+" android:textSize="22sp" />
</LinearLayout>
