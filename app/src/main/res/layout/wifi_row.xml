<?xml version="1.0" encoding="utf-8"?>
<!-- One saved Wi-Fi network: icon, name, delete button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
        android:src="@drawable/ic_wifi" android:tint="@color/muted" android:importantForAccessibility="no" />
    <TextView android:id="@+id/wifi_name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:ellipsize="end" android:singleLine="true"
        android:textColor="@color/on_surface" android:textSize="16sp" />
    <ImageButton android:id="@+id/wifi_delete" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete" android:tint="@color/muted" />
</LinearLayout>
